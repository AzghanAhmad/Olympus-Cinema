NODE_ENV=development
PORT=4000

# Use docker compose (postgres on 5433) so this matches a known password.
# Windows PostgreSQL on 5432 often has a different password and will fail with P1000.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cinema_booking?schema=public

REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SEAT_HOLD_MINUTES=10

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

RESEND_API_KEY=
EMAIL_FROM=Cinema <noreply@cinema.local>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

THROTTLE_TTL=60
THROTTLE_LIMIT=100
